rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'sahidin30@gmail.com' || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    match /saves/{saveId} {
      allow read, write: if request.auth != null && (request.auth.uid == saveId || request.auth.token.email == 'sahidin30@gmail.com' || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
  }
}